# Local / staging env template — copy to `.env.local` (never commit secrets)

# Demo logins (npm run db:seed) — password PFC123!
# leader@pfc.vn (owner) · exec@pfc.vn (leader) · chuyenmon@pfc.vn · truyenthong@pfc.vn
# sukien@pfc.vn · member@pfc.vn · pending@pfc.vn

# Required for signed session cookies (use a long random string)
CLUB_SESSION_SECRET=dev-change-me-club-session-secret

# Required for document download tokens
STORAGE_SIGNING_SECRET=dev-change-me-storage-signing-secret

# Local SQLite path (optional)
# CLUB_DB_PATH=.data/club.sqlite

# Turso / LibSQL (leave empty for local better-sqlite3)
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# Feature flags (omit or set 0 to disable)
# CLUB_FLAG_JOBS=1
# CLUB_FLAG_NOTIFY=1
# CLUB_FLAG_RATE_LIMIT=1
# CLUB_FLAG_SIGNED_DOWNLOAD=1
# CLUB_FLAG_SSO=1
# CLUB_FLAG_EVENT_ENGINE=1

# --- ADR-008 Platform Core SSO (consume) ---
# off | dev | oidc
# PLATFORM_SSO_MODE=dev
# PLATFORM_SSO_SHARED_SECRET=dev-sso-shared-secret-change-me
# PLATFORM_SSO_CLIENT_ID=pfc-club
# PLATFORM_SSO_ISSUER=https://auth.pfc.vn
# PLATFORM_SSO_AUTHORIZE_URL=https://auth.pfc.vn/authorize
# PLATFORM_SSO_REDIRECT_URI=http://127.0.0.1:3000/api/club/sso/callback

# --- Shared Event Engine (link + deep-link; VNPAY lives in Event Hub) ---
# Local: `npm run dev` starts Club :3000 + Event Hub stub :3100 together.
# EVENT_ENGINE_BASE_URL=http://127.0.0.1:3100
# EVENT_HUB_PUBLIC_URL=http://127.0.0.1:3100
# EVENT_HUB_PORT=3100
# CLUB_APP_PUBLIC_URL=http://127.0.0.1:3000

# --- Notification channels (omit → stub log) ---
# NOTIFY_EMAIL_API_KEY=
# NOTIFY_EMAIL_FROM=noreply@pfc.vn
# NOTIFY_EMAIL_ENDPOINT=https://api.resend.com/emails
# NOTIFY_PUSH_WEBHOOK_URL=
# NOTIFY_PUSH_WEBHOOK_TOKEN=
