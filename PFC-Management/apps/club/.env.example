# Copy to .env.local (same folder) then restart `npm run dev`.
# Production (Vercel): set the same names in Project → Settings → Environment Variables.
# Leave values empty here. Never commit real secrets.

# Required everywhere (HMAC session cookie). Generate a long random string for production.
CLUB_SESSION_SECRET=

# Cookie lifetime in seconds (optional; default 604800 = 7 days).
CLUB_SESSION_TTL_SECONDS=

# Production database (Turso / libSQL). Leave empty for local file SQLite.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local file SQLite only (ignored when TURSO_DATABASE_URL is set).
CLUB_DB_PATH=
