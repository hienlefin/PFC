{
  "name": "club",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n club,hub -c magenta,cyan \"npm run dev:club\" \"npm run dev:hub\"",
    "dev:club": "next dev --port 3000",
    "dev:hub": "tsx scripts/event-hub-stub.ts",
    "dev:all": "npm run dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "vitest run src/lib/access.test.ts src/lib/object-authz.test.ts src/lib/session-token.test.ts src/lib/audit-sensitive.test.ts src/app/api/club/route.http.test.ts src/server/membership.lifecycle.test.ts src/server/tasks.lifecycle.test.ts src/server/ops.lifecycle.test.ts src/platform/g6.lifecycle.test.ts src/domain/module-boundary.test.ts",
    "test:g7": "vitest run src/server/critical-path.g7.test.ts src/app/api/club/route.http.test.ts",
    "db:migrate": "tsx scripts/migrate-up.ts",
    "db:migrate:down": "tsx scripts/migrate-down.ts",
    "db:seed": "tsx scripts/seed.ts",
    "screenshots": "tsx scripts/capture-screens.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "libsql": "^0.5.29",
    "nanoid": "^6.0.1",
    "next": "^15.5.2",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.2.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
