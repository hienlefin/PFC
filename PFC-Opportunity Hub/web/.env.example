# Local SQLite (demo). Production: postgresql://pfc:pfc@localhost:5432/opportunity
DATABASE_URL="file:./dev.db"

# Required for expire/remind jobs. Never expose to the browser.
CRON_SECRET="change-me"
# HMAC for CV download links. Min 16 chars. Never send the raw file path.
CV_SIGNING_SECRET="change-me-at-least-16"
# Worker loop. Production: 900000 (15 min). Jobs must not run in the request path.
JOB_INTERVAL_MS="900000"
# Email/push stay SKIPPED until these are set. Do not fake a sent status.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@pfc.vn
# PUSH_WEBHOOK_URL=

# After `docker compose up -d` switch to:
# DATABASE_URL="postgresql://pfc:pfc@localhost:5432/opportunity"
